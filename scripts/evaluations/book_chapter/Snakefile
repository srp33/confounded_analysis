# --- Config ---
# Load all parameters from the config file
configfile: "config.yaml"

OUTPUT_FOLDER = config["output_folder"]
DATA_FOLDER = config["data_folder"]
SCRIPTS_FOLDER = config["scripts_folder"]

# Generate the list of seeds based on the config parameters. [count] seeds, starting at [start]
split_seeds = list(range(config["split_seed_start"], config["split_seed_start"] + config["split_seed_count"]))

# --- Error Reporting ---
import os
from pathlib import Path

def check_for_failures():
    """Check for jobs that have logs but no outputs"""
    failures = []
    
    # Check classify_adjusters
    log_dir = Path(OUTPUT_FOLDER) / "logs" / "classify_adjusters"
    result_dir = Path(OUTPUT_FOLDER) / "results" / "adjusters" / "individual"
    
    if log_dir.exists():
        for log_file in log_dir.glob("*.log"):
            expected_output = result_dir / f"{log_file.stem}.csv"
            if not expected_output.exists():
                failures.append({
                    "log": str(log_file),
                    "expected_output": str(expected_output),
                    "rule": "classify_adjusters"
                })
    
    # Check classify_batch_effects
    log_dir = Path(OUTPUT_FOLDER) / "logs" / "classify_batch_effects"
    result_dir = Path(OUTPUT_FOLDER) / "results" / "batch_effects" / "individual"
    
    if log_dir.exists():
        for log_file in log_dir.glob("*.log"):
            expected_output = result_dir / f"{log_file.stem}.csv"
            if not expected_output.exists():
                failures.append({
                    "log": str(log_file),
                    "expected_output": str(expected_output),
                    "rule": "classify_batch_effects"
                })
    
    return failures

onsuccess:
    failures = check_for_failures()
    if failures:
        report_file = OUTPUT_FOLDER + "/FAILED_JOBS.txt"
        with open(report_file, "w") as f:
            f.write(f"Snakemake Failure Report\n")
            f.write(f"{'='*80}\n")
            f.write(f"Found {len(failures)} failed jobs\n\n")
            
            # Group by rule
            by_rule = {}
            for fail in failures:
                rule = fail['rule']
                if rule not in by_rule:
                    by_rule[rule] = []
                by_rule[rule].append(fail)
            
            for rule, fails in by_rule.items():
                f.write(f"\n{rule}: {len(fails)} failures\n")
                f.write(f"{'-'*80}\n")
                for fail in fails[:20]:  # Show first 20
                    f.write(f"  Log: {fail['log']}\n")
                if len(fails) > 20:
                    f.write(f"  ... and {len(fails) - 20} more\n")
            
            f.write(f"\n{'='*80}\n")
            f.write(f"To see detailed error messages, run:\n")
            f.write(f"  python3 scripts/evaluations/book_chapter/check_failures.py\n")
        
        print(f"\n⚠️  WARNING: {len(failures)} jobs failed. See {report_file} for details.")
        print(f"    Run: python3 scripts/evaluations/book_chapter/check_failures.py\n")
    else:
        print("\n✓ All jobs completed successfully!\n")

onerror:
    print("\n❌ Snakemake encountered an error during execution.\n")

# --- Final Target ---
rule all:
    input:
        OUTPUT_FOLDER + "/batch_on_classifiers.png",
        OUTPUT_FOLDER + "/adjusters_on_classifiers.png"


## Figure 1 Pipeline: How does each classifier respond to batch effects?

# Step 1.3: Create the batch effect plot
rule make_fig1:
    input:
        data=DATA_FOLDER + "/batch_on_classifiers.csv",
        script=SCRIPTS_FOLDER + "/plot_batch_on_classifiers.R"
    output:
        OUTPUT_FOLDER + "/batch_on_classifiers.png"
    log:
        OUTPUT_FOLDER + "/logs/plot_batch_on_classifiers.log"
    shell:
        """
        Rscript {input.script} -i {input.data} -o {output} > {log} 2>&1
        """


# Step 1.2: Aggregate all individual batch effect results
rule aggregate_batch_effects:
    input:
        data=expand(
            OUTPUT_FOLDER + "/results/batch_effects/individual/{classifier}_{mean}_{variance}_{seed}.csv",
            classifier=config["classifiers"],
            variance=config["batch_effect_variances"],
            mean=config["batch_effect_means"],
            seed=split_seeds
        ),
        script=SCRIPTS_FOLDER + "/aggregate_results.R"
    output:
        DATA_FOLDER + "/batch_on_classifiers.csv"
    log:
        OUTPUT_FOLDER + "/logs/aggregate_batch_effects.log"
    params:
        input_dir=OUTPUT_FOLDER + "/results/batch_effects/individual"
    shell:
        """
        Rscript {input.script} --input-dir {params.input_dir} -o {output} > {log} 2>&1
        """


# Step 1.1: Run classification on simulated data
rule classify_batch_effects:
    input:
        data=DATA_FOLDER + "/combined_sub.RData",
        script=SCRIPTS_FOLDER + "/classify_batch_effects.R",
        helper=SCRIPTS_FOLDER + "/helper.R"
    output:
        OUTPUT_FOLDER + "/results/batch_effects/individual/{classifier}_{mean}_{variance}_{seed}.csv"
    log:
        OUTPUT_FOLDER + "/logs/classify_batch_effects/{classifier}_{mean}_{variance}_{seed}.log"
    threads: 1
    resources:
        mem_mb=2000,
        runtime=30
    shell:
        """
        Rscript {input.script} -o {output} \
            --mean {wildcards.mean} --var {wildcards.variance} --classifier {wildcards.classifier} --seed {wildcards.seed} \
            > {log} 2>&1
        """


## Figure 2 Pipeline: How does each adjuster help mitigate batch effects, for each classifier?

# Step 2.3: Create the adjuster plot
