            --adjuster {wildcards.adjuster} --classifier {wildcards.classifier} --num-datasets {wildcards.n_datasets} --seed {wildcards.seed} \
            > {log} 2>&1
        """


## Visualization Pipeline: Visualize batch adjustment effects

# Step 3.1: Generate individual visualizations for each adjuster
rule visualize_batch_adjustment:
    input:
        data=DATA_FOLDER + "/TB_real_data.RData",
        script=SCRIPTS_FOLDER + "/visualize_batch_adjustment.R",
        helper=SCRIPTS_FOLDER + "/helper.R"
    output:
        pca=OUTPUT_FOLDER + "/visualizations/unreduced/individual/pca/{adjuster}_n{n_datasets}_test{test_study}.png",
        lda=OUTPUT_FOLDER + "/visualizations/unreduced/individual/lda/{adjuster}_n{n_datasets}_test{test_study}.png",
        umap=OUTPUT_FOLDER + "/visualizations/unreduced/individual/umap/{adjuster}_n{n_datasets}_test{test_study}.png"
    log:
        OUTPUT_FOLDER + "/logs/visualize_batch_adjustment/{adjuster}_n{n_datasets}_test{test_study}.log"
    threads: 1
    resources:
        mem_mb=4000,
        runtime=10
    params:
        output_dir=OUTPUT_FOLDER + "/visualizations/unreduced/individual"
    shell:
        """
        Rscript {input.script} \
            --adjuster {wildcards.adjuster} \
            --num-datasets {wildcards.n_datasets} \
            --test-study {wildcards.test_study} \
            --output-dir {params.output_dir} \
            --reduce 0 \
            > {log} 2>&1
        """


# Step 3.2: Create comparison grids
rule create_visualization_grid:
    input:
        plots=expand(
            OUTPUT_FOLDER + "/visualizations/unreduced/individual/{{method}}/{adjuster}_n{{n_datasets}}_test{{test_study}}.png",
            adjuster=config["adjusters"]
        ),
        script=SCRIPTS_FOLDER + "/create_visualization_grid.R"
    output:
        OUTPUT_FOLDER + "/visualizations/unreduced/grids/{method}_n{n_datasets}_test{test_study}.png"
    log:
        OUTPUT_FOLDER + "/logs/visualization_grids/{method}_n{n_datasets}_test{test_study}.log"
    threads: 1
    resources:
        mem_mb=2000,
        runtime=5
    params:
        input_dir=OUTPUT_FOLDER + "/visualizations/unreduced/individual"
    shell:
        """
        Rscript {input.script} \
            --input-dir {params.input_dir} \
            --output-file {output} \
            --method {wildcards.method} \
            --num-datasets {wildcards.n_datasets} \
            --test-study {wildcards.test_study} \
            > {log} 2>&1
        """