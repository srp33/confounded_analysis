    shell:
        """
        Rscript {input.script} -i {input.data} -o {output} > {log} 2>&1
        """


# Step 2.2: Aggregate all individual adjuster results
rule aggregate_adjusters:
    input:
        data=expand(
            OUTPUT_FOLDER + "/results/adjusters/individual/{adjuster}_{classifier}_{n_datasets}_{seed}.csv",
            adjuster=config["adjusters"],
            classifier=config["classifiers"],
            n_datasets=config["num_datasets"],
            seed=split_seeds
        ),
        script=SCRIPTS_FOLDER + "/aggregate_results.R"
    output:
        DATA_FOLDER + "/adjusters_on_classifiers.csv"
    log:
        OUTPUT_FOLDER + "/logs/aggregate_adjusters.log"
    params:
        input_dir=OUTPUT_FOLDER + "/results/adjusters/individual"
    shell:
        """
        Rscript {input.script} \
            --input-dir {params.input_dir} -o {output} \
            > {log} 2>&1
        """


# Step 2.1: Run classification on real data
rule classify_adjusters:
    input:
        data=DATA_FOLDER + "/TB_real_data.RData",
        script=SCRIPTS_FOLDER + "/classify_adjusters.R",
        helper=SCRIPTS_FOLDER + "/helper.R",
    output:
        OUTPUT_FOLDER + "/results/adjusters/individual/{adjuster}_{classifier}_{n_datasets}_{seed}.csv"
    log:
        OUTPUT_FOLDER + "/logs/classify_adjusters/{adjuster}_{classifier}_{n_datasets}_{seed}.log"
    threads: 1
    resources:
        mem_mb=2000,
        runtime=60
    shell:
        """
        Rscript {input.script} -o {output} \
            --adjuster {wildcards.adjuster} --classifier {wildcards.classifier} --num-datasets {wildcards.n_datasets} --seed {wildcards.seed} \
            > {log} 2>&1
        """