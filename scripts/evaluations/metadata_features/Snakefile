configfile: "config.yaml"

import os 
import glob 

# Config 
OUTPUT_DIR = config["output_folder"]
DATA_DIR = config["data_folder"]
SCRIPTS_DIR = config.get("scripts_dir", ".")
ADJUST_SCRIPT = config.get("adjust_script", "../../adjust/adjust.R")

ADJUSTERS = config["adjusters"]
TARGETS = config["targets"]

TOP_K = config["top_k"]
THRESHOLD = config["threshold"]

N_REPEATS = config["n_repeats"]
N_JOBS = config["n_jobs"]
RANDOM_STATE = config["random_state"]

SUBSET_DIR = os.path.join(OUTPUT_DIR, "subset")
ADJUST_DIR = os.path.join(OUTPUT_DIR, "adjusted")
CLASSIFY_DIR = os.path.join(OUTPUT_DIR, "classify")
PERM_DIR = os.path.join(OUTPUT_DIR, "permutation_importance")
PLOT_DIR = os.path.join(OUTPUT_DIR, "plots")

# Rules
rule all:
    input:
        [  # combine both expand calls into a single list
            *expand(os.path.join(PLOT_DIR, "{target}_permutation_importance_heatmap.png"), target=TARGETS),
            *expand(os.path.join(PLOT_DIR, "filtered_{target}_permutation_importance.csv"), target=TARGETS)
        ]

rule rank_and_select_top_genes:
    input:
        aggregated_csv=os.path.join(PLOT_DIR, "{target}_aggregated_permutation_importance.csv")
    output:
        filtered_csv=os.path.join(PLOT_DIR, "filtered_{target}_permutation_importance.csv"),
        top_genes_dir=directory(os.path.join(PLOT_DIR, "top_genes_{target}"))
    params:
        top_k=TOP_K,
        threshold=THRESHOLD
    shell:
        """
        python {SCRIPTS_DIR}/rank_and_select_top_genes.py \
            --aggregated_csv {input.aggregated_csv} \
            --outdir {output.top_genes_dir} \
            --top_k {params.top_k} \
            --threshold {params.threshold} \
            --filtered_csv {output.filtered_csv}
        """

rule aggregate_and_plot_heatmap:
    input:
        importance=lambda wildcards: expand(os.path.join(PERM_DIR, "{adjuster}", f"{wildcards.target}_permutation_importance.csv"),
                                        adjuster=ADJUSTERS)
    output:
        heatmap=os.path.join(PLOT_DIR, "{target}_permutation_importance_heatmap.png"),
        aggregated_csv=os.path.join(PLOT_DIR, "{target}_aggregated_permutation_importance.csv")
    params:
        aggregation="mean"  # could also be median
    shell:
        """
        python {SCRIPTS_DIR}/aggregate_and_plot_heatmap.py \
            --importance_dir {PERM_DIR} \
            --adjusters {ADJUSTERS} \
            --target {wildcards.target} \
            --outdir {PLOT_DIR} \
            --aggregation {params.aggregation}
        """ 

rule permutation_importance:
    input:
        csv=os.path.join(CLASSIFY_DIR, "{adjuster}", "{adjuster}_{k}studies_test_{test_source}_metrics.csv"),
        models_dir=directory(os.path.join(CLASSIFY_DIR, "{adjuster}", "models"))
    output:
        importance=os.path.join(PERM_DIR, "{adjuster}", "{target}_permutation_importance.csv")
    params:
        n_repeats=N_REPEATS,
        n_jobs=N_JOBS,
        random_state=RANDOM_STATE
    shell:
        """
        python {SCRIPTS_DIR}/permutation_importance.py \
            --csv {input.csv} \
            --target {wildcards.target} \
            --outdir {ADJUST_DIR}/{wildcards.adjuster} \
            --n_repeats {params.n_repeats} \
            --n_jobs {params.n_jobs} \
            --random_state {params.random_state}
        """

rule train_metrics:
    input: 
        csv=os.path.join(ADJUST_DIR, "{adjuster}", "{adjuster}_{k}studies_test_{test_source}.csv")
    output:
        metrics=os.path.join(CLASSIFY_DIR, "{adjuster}", "{adjuster}_{k}studies_test_{test_source}_metrics.csv"),
        models_dir=directory(os.path.join(CLASSIFY_DIR, "{adjuster}", "models"))
    params: 
        random_state=RANDOM_STATE 
    shell:
        """
        python {SCRIPTS_DIR}/train_and_metrics.py \
        --csv {input.csv} \
        --outdir {ADJUST_DIR}/{wildcards.adjuster} \
        --random_state {params.random_state}
        """

rule adjust: 
    input: 
        subset=os.path.join(SUBSET_DIR, "{k}studies_test_{test_source}_aligned.csv")
    output: 
        adjusted=os.path.join(
            ADJUST_DIR,
            "{adjuster}",
            "{adjuster}_{k}studies_test_{test_source}.csv"
        )
    log: 
        "logs/adjust/{adjuster}_{k}_{test_source}_adjust.log"
    params:
        output_dir=ADJUST_DIR,
        adjust_script=ADJUST_SCRIPT,
        metadata=os.path.join(DATA_DIR, "geo_metadata.csv") 
    shell:
        """
        set -euo pipefail
        Rscript {SCRIPTS_DIR}/run_scaling_experiment.R \
            --adjuster {wildcards.adjuster} \
            --subset-path {input.subset} \
            --k {wildcards.k} \
            --test {wildcards.test_source} \
            --output-dir {params.output_dir} \
            --adjust-script {params.adjust_script} \
            --metadata-file {params.metadata} \
            &> {log}
        """

rule align_metadata:
    input: 
        subset=os.path.join(SUBSET_DIR, "{k}studies_test_{test_source}_subset.csv")
    output:
        aligned=directory(os.path.join(SUBSET_DIR, "{k}studies_test_{test_source}_aligned.csv"))
    log:
        "logs/align/alignment.log"
    shell:
        """
        set -euo pipefail
        python {SCRIPTS_DIR}/align_metadata.py \
            --input {input.subset} \
            --output {output.aligned} \
            &> {log}
        """

rule subset:
    input: 
        combined_file=os.path.join(DATA_DIR, "all_combined/all_combined.csv")
    output: 
        subset_file=os.path.join(SUBSET_DIR, "{k}studies_test_{test_source}_subset.csv")
    log: 
        "logs/subset/test_{test_source}_subset.log"
    params:
        data_list=config['dataset_list']
    shell:
        """
        set -euo pipefail
        python {SCRIPTS_DIR}/subset_datasets.py \
            --input {input.combined_file} \
            --test {test_source} \
            --dataset_list {params.data_list} \
            --output {output.subset_file} \
            &> {log}
        """

rule combine:
    input: 
        gold_dir=directory(os.path.join(DATA_DIR, "gold"))
    output:
        combined_file=os.path.join(DATA_DIR, "all_combined/all_combined.csv")
    log: 
        "logs/combine.log"
    shell:
        """
        python {SCRIPTS_DIR}/combine_all.py --input-dir {input.gold_dir} --output-file {output.combined_file} &> {log}
        """