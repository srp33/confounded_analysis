configfile: "config.yaml"

import os 
import glob 

# Config 
OUTPUT_DIR = config["output_folder"]
DATA_DIR = config["data_folder"]
SCRIPTS_DIR = config.get("scripts_dir", ".")
ADJUST_SCRIPT = config.get("adjust_script", "../../adjust/adjust.R")

ADJUSTERS = config["adjusters"]
TARGETS = config["targets"]

TOP_K = config["top_k"]
THRESHOLD = config["threshold"]

N_REPEATS = config["n_repeates"]
N_JOBS = config["n_jobs"]
RANDOM_STATE = config["random_state"]

SUBSET_DIR = os.path.join(OUTPUT_DIR, "subset")
ADJUST_DIR = os.path.join(OUTPUT_DIR, "labeled_adjusted")

# Rules
rule all: 
    input: 
        expand(
            os.path.join(ADJUST_DIR, "{adjuster}", "{target}_permutation_importance_heatmap.png"),
            adjuster=ADJUSTERS,
            target=TARGETS
        )

rule plot_and_select_genes:
    input:
        importance=os.path.join(ADJUST_DIR, "{adjuster}", "{target}_permutation_importance.csv")
    output:
        heatmap=os.path.join(ADJUST_DIR, "{adjuster}", "{target}_permutation_importance_heatmap.png"),
        filtered_csv=os.path.join(ADJUST_DIR, "{adjuster}", "filtered_{target}_permutation_importance.csv")
    params:
        top_k=TOP_K,
        threshold=THRESHOLD
    shell:
        """
        python {SCRIPTS_DIR}/plot_and_gene_selection.py \
            --importance_csv {input.importance} \
            --outdir {ADJUST_DIR}/{wildcards.adjuster} \
            --top_k {params.top_k} \
            --threshold {params.threshold}
        """  

rule permutation_importance:
    input:
        csv=os.path.join(ADJUST_DIR, "{adjuster}", "{adjuster}.csv"),
        models_dir=directory(os.path.join(ADJUST_DIR, "{adjuster}", "models"))
    output:
        importance=os.path.join(ADJUST_DIR, "{adjuster}", "{target}_permutation_importance.csv")
    params:
        n_repeats=N_REPEATS,
        n_jobs=N_JOBS,
        random_state=RANDOM_STATE
    shell:
        """
        python {SCRIPTS_DIR}/permutation_importance.py \
            --csv {input.csv} \
            --target {wildcards.target} \
            --outdir {ADJUST_DIR}/{wildcards.adjuster} \
            --n_repeats {params.n_repeats} \
            --n_jobs {params.n_jobs} \
            --random_state {params.random_state}
        """

rule train_metrics:
    input: 
        csv=os.path.join(ADJUST_DIR, "{adjuster}", "{adjuster}.csv")
    output:
        metrics=os.path.join(ADJUST_DIR, "{adjuster}", "{adjuster}_metrics.csv"),
        models_dir=os.path.join(ADJUST_DIR, "{adjuster}", "models")
    params: 
        random_state=RANDOM_STATE 
    shell:
        """
        python {SCRIPTS_DIR}/train_and_metrics.py \
        --csv {input.csv} \
        --outdir {ADJUST_DIR}/{wildcards.adjuster} \
        --random_state {params.random_state}
        """

rule adjust: 
    input: 
        subset=os.path.join(SUBSET_DIR, "{k}studies_test_{test_source}.csv")
    output: 
        adjusted=os.path.join(
            ADJUST_DIR,
            "{adjuster}",
            "{adjuster}_{k}studies_test_{test_source}.csv"
        )
    log: 
        "logs/adjust/{adjuster}_{k}_{test_source}_adjust.log"
    params:
        output_dir=ADJUST_DIR,
        adjust_script=ADJUST_SCRIPT,
        metadata=os.path.join(OUTPUT_DIR, "geo_metadata.csv") 
    shell:
        """
        set -euo pipefail
        Rscript {SCRIPTS_DIR}/run_scaling_experiment.R \
            --adjuster {wildcards.adjuster} \
            --subset-path {input.subset} \
            --k {wildcards.k} \
            --test {wildcards.test_source} \
            --output-dir {params.output_dir} \
            --adjust-script {params.adjust_script} \
            --metadata-file {params.metadata} \
            &> {log}
        """

rule align_metadata:
    input: 
        subset=os.path.join(SUBSET_DIR, "labeled_subset.csv")
    output:
        aligned=os.path.join(SUBSET_DIR, "aligned_subset")
    log:
        "logs/align/alignment.log"
    shell:
        """
        set -euo pipefail
        python {SCRIPTS_DIR}/align_metadata.py \
            --input {input.subset} \
            --output {output.aligned} \
            &> {log}
        """

rule subset:
    input: 
        combined_file=os.path.join(DATA_DIR, "all_combined/all_combined.csv")
    output: 
        subset_file=os.path.join(SUBSET_DIR, "labeled_subset.csv")
    log: 
        "logs/subset/tese_{test_source}_subset.log"
    params:
        data_list=config['dataset_list']
    shell:
        """
        set -euo pipefail
        python {SCRIPTS_DIR}/subset_datasets.py \
            --input {input.combined_file} \
            --test {test_source} \
            --dataset_list {params.data_list} \
            --output {output.subset_file} \
            &> {log}
        """

rule combine:
    input: 
        gold_dir=os.path.join(DATA_DIR, "gold")
    output:
        combined_file=os.path.join(DATA_DIR, "all_combined/all_combined.csv")
    log: 
        "logs/combine.log"
    shell:
        """
        python {SCRIPTS_DIR}/combine_all.py --input-dir {input.gold_dir} --output-file {output.combined_file} &> {log}
        """