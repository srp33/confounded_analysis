configfile: "config.yaml"

import os

# -------------------------
# Config
# -------------------------
OUTPUT_DIR = config["output_folder"]
DATA_DIR = config["data_folder"]
SCRIPTS_DIR = config.get("scripts_dir", ".")
COMBINE_SCRIPT = config["combine_script"]
ADJUST_SCRIPT = config.get("adjust_script", "../../adjust/adjust.R")
SCALING_SCRIPT = config.get("scaling_script", "../classify_er_all_datasets/run_scaling_experiment.R")

ADJUSTERS = config["adjusters"]
TARGETS = config["targets"]
K_VALUES = [2]
TEST_SOURCES = config["test_sources"]

TOP_K = config["top_k"]
THRESHOLD = config["threshold"]

N_REPEATS = config["n_repeats"]
N_JOBS = config["n_jobs"]
RANDOM_STATE = config["random_state"]

SUBSET_DIR = os.path.join(OUTPUT_DIR, "subset")
ADJUST_DIR = os.path.join(OUTPUT_DIR, "adjusted")
CLASSIFY_DIR = os.path.join(OUTPUT_DIR, "classify")
PERM_DIR = os.path.join(OUTPUT_DIR, "permutation_importance")
PLOT_DIR = os.path.join(OUTPUT_DIR, "plots")

# -------------------------
# All targets
# -------------------------
rule all:
    input:
        expand(
            os.path.join(
                PLOT_DIR,
                "{k}_{test_source}_{target}_permutation_importance_heatmap.png"
            ),
            k=K_VALUES,
            test_source=TEST_SOURCES,
            target=TARGETS
        ),
        expand(
            os.path.join(
                PLOT_DIR,
                "filtered_{k}_{test_source}_{target}_permutation_importance.csv"
            ),
            k=K_VALUES,
            test_source=TEST_SOURCES,
            target=TARGETS
        )

# -------------------------
# Combine raw datasets
# -------------------------
rule combine:
    input: 
        gold_dir=os.path.join(DATA_DIR, "gold")
    output:
        combined_file=os.path.join(DATA_DIR, "all_combined/combined_labeled.csv")
    log: 
        "logs/combine/combine.log"
    resources:
        mem_mb=16000,
        runtime=60
    shell:
        """
        python {COMBINE_SCRIPT} \
            --input-dir {input.gold_dir} \
            --output-file {output.combined_file} \
            &> {log}
        """

# -------------------------
# Subset datasets
# -------------------------
rule subset:
    input: 
        combined_file=os.path.join(DATA_DIR, "all_combined/combined_labeled.csv")
    output: 
        subset_file=os.path.join(SUBSET_DIR, "{k}studies_test_{test_source}_subset.csv")
    log: 
        "logs/subset/{k}_{test_source}_subset.log"
    resources:
        mem_mb=16000,
        runtime=30
    params:
        data_list=" ".join(config['dataset_list'])
    shell:
        """
        python {SCRIPTS_DIR}/subset_datasets.py \
            --input {input.combined_file} \
            --test {wildcards.test_source} \
            --dataset_list {params.data_list} \
            --out_dir {SUBSET_DIR} \
            &> {log}
        """

# -------------------------
# Align metadata
# -------------------------
rule align_metadata:
    input: 
        subset=os.path.join(SUBSET_DIR, "{k}studies_test_{test_source}_subset.csv")
    output:
        aligned=os.path.join(SUBSET_DIR, "{k}studies_test_{test_source}_aligned.csv")
    log:
        "logs/align/{k}_{test_source}_alignment.log"
    resources:
        mem_mb=4000,
        runtime=30
    shell:
        """
        python {SCRIPTS_DIR}/align_metadata.py \
            --input {input.subset} \
            --output {output.aligned} \
            &> {log}
        """

# -------------------------
# Adjust datasets
# -------------------------
rule adjust: 
    input: 
        aligned=os.path.join(SUBSET_DIR, "{k}studies_test_{test_source}_aligned.csv")
    output: 
        adjusted=os.path.join(
            ADJUST_DIR,
            "{adjuster}",
            "{adjuster}_{k}studies_test_{test_source}.csv"
        )
    log: 
        "logs/adjust/{adjuster}_{k}_{test_source}_adjust.log"
    resources:
        mem_mb=2400,
        runtime=90
    params:
        output_dir=ADJUST_DIR,
        adjust_script=ADJUST_SCRIPT,
        metadata=os.path.join(DATA_DIR, "geo_metadata.csv") 
    shell:
        """
        set -euo pipefail
        Rscript {SCALING_SCRIPT} \
            --adjuster {wildcards.adjuster} \
            --subset-path {input.aligned} \
            --k {wildcards.k} \
            --test {wildcards.test_source} \
            --output-dir {params.output_dir} \
            --adjust-script {params.adjust_script} \
            --metadata-file {params.metadata} \
            &> {log}
        """

# -------------------------
# Train models and compute metrics
# -------------------------
rule train_metrics:
    input: 
        csv=os.path.join(ADJUST_DIR, "{adjuster}", "{adjuster}_{k}studies_test_{test_source}.csv")
    output:
        metrics=os.path.join(CLASSIFY_DIR, "{adjuster}", "{adjuster}_{k}studies_test_{test_source}_metrics.csv")
    log:
        "logs/train/{adjuster}_{k}_{test_source}_train.log"
    resources:
        mem_mb=32000,
        runtime=30
    params: 
        random_state=RANDOM_STATE 
    shell:
        """
        python {SCRIPTS_DIR}/train_and_metrics.py \
            --csv {input.csv} \
            --outdir {CLASSIFY_DIR}/{wildcards.adjuster} \
            --random_state {params.random_state} \
            &> {log}
        """

# -------------------------
# Permutation importance
# -------------------------
rule permutation_importance:
    input:
        csv=os.path.join(ADJUST_DIR, "{adjuster}", "{adjuster}_{k}studies_test_{test_source}.csv"),
        models_dir=os.path.join(CLASSIFY_DIR, "{adjuster}", "models")
    output:
        importance=os.path.join(PERM_DIR, "{adjuster}", "{k}_{test_source}_permutation_importance.csv")
    log:
        "logs/perm/{adjuster}_{k}_{test_source}_perm.log"
    resources: 
        mem_mb=32000,
        runtime=960
    params:
        n_repeats=N_REPEATS,
        n_jobs=N_JOBS,
        random_state=RANDOM_STATE
    shell:
        """
        python {SCRIPTS_DIR}/permutation_importance.py \
            --csv {input.csv} \
            --models_dir {input.models_dir} \
            --outdir {PERM_DIR}/{wildcards.adjuster} \
            --n_repeats {params.n_repeats} \
            --n_jobs {params.n_jobs} \
            --random_state {params.random_state} \
            &> {log}
        """

# -------------------------
# Aggregate and plot heatmaps
# -------------------------
rule aggregate_and_plot_heatmap:
    input:
        importance=lambda wc: expand(
            os.path.join(PERM_DIR, "{adjuster}", f"{wc.k}_{wc.test_source}_permutation_importance.csv"),
            adjuster=ADJUSTERS,
            test_source=TEST_SOURCES
        )
    output:
        heatmap=os.path.join(
            PLOT_DIR,
            "{k}_{test_source}_{target}_permutation_importance_heatmap.png"
        ),
        aggregated_csv=os.path.join(
            PLOT_DIR,
            "{k}_{test_source}_{target}_aggregated_permutation_importance.csv"
        )
    log:
        "logs/plot/{k}_{test_source}_{target}_heatmap.log"
    resources:
        mem_mb=8000,
        runtime=60
    params:
        aggregation="mean"
    shell:
        """
        python {SCRIPTS_DIR}/plot_heatmap.py \
            --csvs {input.importance} \
            --outdir {PLOT_DIR} \
            --target {wildcards.target} \
            --agg {params.aggregation} \
            &> {log}
        """

# -------------------------
# Rank and select top genes
# -------------------------
rule rank_and_select_top_genes:
    input:
        importance=lambda wc: expand(
            os.path.join(PLOT_DIR, "{adjuster}_{k}_{test_source}_{target}_aggregated_permutation_importance.csv"),
            adjuster=ADJUSTERS,
            k=K_VALUES,
            test_source=TEST_SOURCES,
            target=TARGETS
        )
    output:
        filtered_csv=os.path.join(PLOT_DIR, "filtered_{k}_{test_source}_{target}_permutation_importance.csv"),
        top_genes_dir=directory(os.path.join(PLOT_DIR, "top_genes_{k}_{test_source}_{target}"))
    log:
        "logs/top_genes/{k}_{test_source}_{target}.log"
    resources: 
        mem_mb=8000,
        runtime=60
    params:
        top_k=TOP_K,
        threshold=THRESHOLD,
        aggregation="mean"
    shell:
        """
        python {SCRIPTS_DIR}/rank_and_select_top_genes.py \
            --csvs {input.importance} \
            --outdir {output.top_genes_dir} \
            --top_k {params.top_k} \
            --threshold {params.threshold} \
            --agg {params.aggregation} \
            &> {log}
        """