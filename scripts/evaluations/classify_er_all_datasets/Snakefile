configfile: "config.yaml"

OUTPUT_FOLDER = config["output_folder"]
DATA_FOLDER = config["data_folder"]

rule all: 
    input: 
        OUTPUT_FOLDER + "/classify_all_figures/absolute_scaling_MCC.png", 
        OUTPUT_FOLDER + "/classify_all_figures/absolute_scaling_ROC_AUC.png",
        OUTPUT_FOLDER + "/classify_all_figures/scaling_MCC.png",
        OUTPUT_FOLDER + "/classify_all_figures/scaling_ROC_AUC.png"

rule plot_performance:
    priority: 60
    input:
        aggregated_metrics_file=OUTPUT_FOLDER + "/classify_er_all/all_metrics.csv"
    output: 
        OUTPUT_FOLDER + "/classify_all_figures/absolute_scaling_MCC.png", 
        OUTPUT_FOLDER + "/classify_all_figures/absolute_scaling_ROC_AUC.png",
        OUTPUT_FOLDER + "/classify_all_figures/scaling_MCC.png",
        OUTPUT_FOLDER + "/classify_all_figures/scaling_ROC_AUC.png"
    resources: 
        mem_mb=4000,
        runtime=20
    threads: 1
    log: 
        "log/plot_performance.log"
    params:
        fig_dir = OUTPUT_FOLDER
        metadata_file = "/home/aw998/confounded_analysis/geo_metadata.csv"
    shell:
        """
        set -euo pipefail
        Rscript plot_performance.R \
            --metrics_file {input} \
            --figures_dir {params.fig_dir} \
            --metadata_file {params.metadata_file} \
            &> {log}
        """

rule aggregate_metrics:
    priority: 70
    input: 
        metrics_data=expand(
            OUTPUT_FOLDER + "/metrics/{adjuster}/{adjuster}_{k}studies_test_{test_source}_metrics.csv",
            adjuster=config["adjuster"],
            k=list(range(1,15)),
            test_source=config["dataset_ids"]
        ),
        metrics_dir=OUTPUT_FOLDER + "/metrics"
    output:
        output_path=OUTPUT_FOLDER + "/classify_er_all/all_metrics.csv"
    resources: 
        mem_mb=4000,
        runtime=20
    threads: 1
    log: 
        "log/aggregate.log"
    shell:
        """
        set -euo pipefail
        python aggregate_metrics.py --metrics-dir {metrics_dir} --output {output_path} &> {log}
        """

rule classify:
    priority: 80
    input:
        adjusted_csv = DATA_FOLDER + "/adjusted_data/{adjuster}/{adjuster}_{k}studies_test_{test_source}.csv"
    output: 
        metrics_file = OUTPUT_FOLDER + "/metrics/{adjuster}/{adjuster}_{k}studies_test_{test_source}_metrics.csv"
    log: 
        "log/classify/{adjuster}_{k}_{test_source}_classify.log"
    resources: 
        mem_mb=16000,
        runtime=90
    threads: 1
    params:
        output_dir = OUTPUT_FOLDER + "/metrics",
        bootstrap = 100
    shell:
        """
        set -euo pipefail
        python run_classifier.py \
            --csv {input.adjusted_csv} \
            --outdir {params.output_dir} \
            --bootstrap {params.bootstrap} \
            &> {log}
        """

rule adjust: 
    priority: 90
    input: 
        DATA_FOLDER + "/subset_data/{k}studies_test_{test_source}.csv"
    output: 
        DATA_FOLDER + "/adjusted_data/{adjuster}/{adjuster}_{k}studies_test_{test_source}.csv"
    resources: 
        mem_mb=16000,
        runtime=60
    threads: 1
    log: 
        "log/adjust/{adjuster}_{k}_{test_source}_adjust.log"
    shell:
        """
        set -euo pipefail
        Rscript run_scaling_experiment.R \
            --adjuster {wildcards.adjuster} \
            --subset-path {input} \
            --k {wildcards.k} \
            --test {wildcards.test_source} \
            &> {log}
        """

rule subset:
    priority: 100
    input:
        combined_file = DATA_FOLDER + "/all_combined/all_combined.csv",
        order_file = DATA_FOLDER + "/all_combined/gse_order_files/{test_source}_order.csv"
    output:
        DATA_FOLDER + "/subset_data/{k}studies_test_{test_source}.csv"
    resources: 
        mem_mb=16000,
        runtime=30
    threads: 1
    log: 
        "log/subset/{k}_{test_source}_subset.log"
    shell:
        """
        set -euo pipefail
        Rscript subset_prep.R \
        --input {input.combined_file} \
        --test {wildcards.test_source} \
        --order {input.order_file} \
        --k {wildcards.k} \
        --output {output} \
        &> {log}
        """

rule make_order_files:
    input: 
        combined_file = DATA_FOLDER + "/all_combined/all_combined.csv"
    output: 
        order_file = DATA_FOLDER + "/all_combined/gse_order_files/{test_source}_order.csv"
    resources: 
        mem_mb=4000,
        runtime=10
    threads: 1
    log: 
        "log/order/{test_source}_order.log"
    shell:
        """
        set -euo pipefail
        python make_order_files.py {input.combined_file} {output} &> {log}
        
        """

rule combine:
    input: 
        DATA_FOLDER + "/gold"
    output:
        DATA_FOLDER + "/all_combined/all_combined.csv"
    resources: 
        mem_mb=4000,
        runtime=60
    threads: 1
    log: 
        "log/combine.log"
    shell:
        """
        python combine_all.py --input-dir {input} --output-file {output} &> {log}
        """