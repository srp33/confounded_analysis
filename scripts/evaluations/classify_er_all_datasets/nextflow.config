// ------------------------------
// Nextflow Config for HPC + Apptainer
// ------------------------------

nextflow.enable.dls = 1

/* Executor settings */
process {
    executor = 'slurm'
    queue = 'normal'         // change if your cluster uses a different partition
    cpus = 8                 // default for each process
    memory = '16 GB'
    time = '10h'

    // Enable Apptainer (Singularity) for containerized execution
    container = '/apptainer/remove-batch-effects.sif'
    singularity.enabled = true
}

/* Logging */
trace {
    enabled = true
    file = 'logs/trace.log'
}

/* Resume workflow if partially completed */
resume = true