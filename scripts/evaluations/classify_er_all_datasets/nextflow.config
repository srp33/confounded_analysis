// ------------------------------
// Nextflow Config for HPC + Apptainer
// ------------------------------

nextflow.enable.dls = 1

/* Executor settings */
process {
    executor = 'slurm'
    queue = 'm8'         // change if your cluster uses a different partition
    cpus = 8                 // default for each process
    memory = '16 GB'
    time = '10h'

    // Enable Apptainer (Singularity) for containerized execution
    container = '/home/aw998/confounded_analysis/apptainer/remove-batch-effects.sif'
    singularity.enabled = false

    beforeScript = 'module load apptainer'
}

/* Logging */
trace {
    enabled = true
    overwrite = true
    file = 'logs/trace.log'
}

/* Resume workflow if partially completed */
resume = true