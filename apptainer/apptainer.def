Bootstrap: docker
From: ubuntu:22.04

# Set base environment variables
%environment
export LANG="C.UTF-8"
export LC_ALL="C.UTF-8"
export TZ="America/Denver"

# Set Conda and R environment variables
export CONDA_DIR="/opt/conda"
export PATH="$CONDA_DIR/bin:$PATH"
export CONDA_PREFIX="$CONDA_DIR"
export RETICULATE_PYTHON="$CONDA_DIR/bin/python"
export R_LIBS_USER="/home/r_libs"
export TORCHINDUCTOR_CACHE_DIR="/tmp/torch_cache"
export NUMBA_CACHE_DIR="/tmp/numba_cache"

# Configure ccache
export PATH="/usr/lib/ccache:$PATH"
export CC="ccache gcc"
export CXX="ccache g++"
export CCACHE_DIR="/cache/ccache"

#Copy the R installation script into the container before the build
%files
    install_apptainer_packages.R /install_apptainer_packages.R

%post
    echo "Starting build process..."
    # Enable debugging: Print all commands (set -x) and exit on first error (set -e).
    set -ex

    # Stage 1: Install system-level dependencies
    echo "Setting up Ubuntu 22.04 environment..."
    
    # Set timezone to avoid interactive prompts
    export DEBIAN_FRONTEND=noninteractive
    ln -fs /usr/share/zoneinfo/America/Denver /etc/localtime
    
    apt-get clean
    apt-get update
    apt-get install -y --no-install-recommends \
        wget curl ca-certificates gnupg2 dirmngr software-properties-common \
        git ccache build-essential cmake \
        python3 python3-pip python3-dev \
        libssl-dev libcurl4-openssl-dev libxml2-dev \
        libfontconfig1-dev libharfbuzz-dev libfribidi-dev \
        libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev

    # --- Install Latest R (≥ 4.3) ---
    echo "=== Installing latest R (>= 4.3) ==="
    wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc | tee -a /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc
    add-apt-repository "deb https://cloud.r-project.org/bin/linux/ubuntu jammy-cran40/"
    apt-get update
    apt-get install -y --no-install-recommends r-base r-base-dev

    # Clean out conflicting system packages
    rm -rf /usr/lib/R/library/Matrix /usr/lib/R/library/Recommended

    echo "options(repos = c(CRAN='https://packagemanager.posit.co/cran/__linux__/jammy/2024-01-01'))" >> /etc/R/Rprofile.site

    apt-get clean
    rm -rf /var/lib/apt/lists/*
    
    # Verify tools are working
    cmake --version
    R --version
    python3 --version

    # Stage 2: Build the Python environment
    echo "Downloading Miniforge3 installer..."
    wget https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/miniforge.sh
    /bin/bash /tmp/miniforge.sh -b -p /opt/conda
    rm /tmp/miniforge.sh

    /opt/conda/bin/conda update -y -n base -c conda-forge conda
    # Fix solver issue after conda update
    /opt/conda/bin/conda config --set solver classic
    /opt/conda/bin/conda install -y -c conda-forge mamba
    /opt/conda/bin/mamba install -y -c conda-forge numpy 'scikit-learn>=1.4' pandas pytorch matplotlib \
                                        aif360 tabulate jaxtyping beartype pytables opentsne umap-learn geoparse seaborn \
                                        psutil tqdm rich memory_profiler py-cpuinfo
    /opt/conda/bin/pip install gdown osfclient pybiomart
    /opt/conda/bin/conda clean --all -y

    # Stage 3: Build the R environment
    # R library setup
    mkdir -p /home/r_libs
    chmod -R 777 /home/r_libs

    # R package installation
    Rscript /install_apptainer_packages.R
    Rscript -e "pak::cache_clean()"

    # Final Stage: Assemble
    # Create final directories and clone repositories
    mkdir -p /tmp/numba_cache
    chmod -R 777 /tmp/numba_cache
    git clone https://github.com/datapplab/AutoClass.git /opt/AutoClass

    echo "Build completed."