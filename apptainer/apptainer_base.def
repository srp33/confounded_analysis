Bootstrap: docker
From: ubuntu:22.04

# Base image with system dependencies and core R packages
# Build this once and reuse for faster subsequent builds

%environment
export LANG="C.UTF-8"
export LC_ALL="C.UTF-8"
export TZ="America/Denver"
export R_LIBS_USER="/home/r_libs"

# Configure ccache for faster compilation
export PATH="/usr/lib/ccache:$PATH"
export CC="ccache gcc"
export CXX="ccache g++"
export CCACHE_DIR="/cache/ccache"
export CCACHE_MAXSIZE="8G"
export CCACHE_COMPRESS="true"
export CCACHE_COMPRESSLEVEL="6"

%files
    apptainer/install_base_packages.R /install_base_packages.R

%post
    echo "=== STARTING BASE IMAGE BUILD ==="
    echo "Build started at: $(date)"
    echo "Available memory: $(free -h)"
    echo "Available disk space: $(df -h /)"
    
    # Enable debugging: Print all commands (set -x) and exit on first error (set -e)
    set -ex
    
    echo "=== STAGE 1: SYSTEM SETUP ==="
    export DEBIAN_FRONTEND=noninteractive
    ln -fs /usr/share/zoneinfo/America/Denver /etc/localtime
    
    echo "Cleaning package cache..."
    apt-get clean
    
    echo "Updating package lists..."
    apt-get update
    
    echo "=== STAGE 2: INSTALLING SYSTEM DEPENDENCIES ==="
    echo "Installing basic system packages..."
    apt-get install -y --no-install-recommends \
        wget curl ca-certificates gnupg2 dirmngr software-properties-common \
        git ccache build-essential cmake \
        python3 python3-pip python3-dev \
        libssl-dev libcurl4-openssl-dev libxml2-dev \
        libfontconfig1-dev libharfbuzz-dev libfribidi-dev \
        libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev \
        apt-transport-https libx11-dev libmagick++-dev gsfonts pandoc libglpk-dev libwebp-dev
    
    echo "=== STAGE 3: ADDING R REPOSITORY AND INSTALLING R ==="
    echo "Adding R repository for latest R version..."
    wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc | tee -a /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc
    add-apt-repository "deb https://cloud.r-project.org/bin/linux/ubuntu jammy-cran40/"
    
    echo "Updating package lists after adding R repository..."
    apt-get update
    
    echo "Installing R..."
    apt-get install -y --no-install-recommends r-base r-base-dev
    
    # Clean out conflicting system packages
    echo "Cleaning conflicting R packages..."
    rm -rf /usr/lib/R/library/Matrix /usr/lib/R/library/Recommended
    
    echo "Setting R repository..."
    echo "options(repos = c(CRAN='https://packagemanager.posit.co/cran/__linux__/jammy/2024-01-01'))" >> /etc/R/Rprofile.site
    
    echo "Cleaning package cache..."
    apt-get clean && rm -rf /var/lib/apt/lists/*
    
    echo "=== STAGE 4: SETUP CCACHE ==="
    mkdir -p /cache/ccache && chmod -R 777 /cache/ccache
    ccache --set-config=max_size=8G
    ccache --set-config=compression=true
    ccache --set-config=compression_level=6
    
    echo "=== STAGE 5: VERIFY TOOLS ==="
    echo "CMake version:"
    cmake --version
    echo "R version:"
    R --version
    echo "Python version:"
    python3 --version
    echo "ccache configuration:"
    ccache --show-config
    
    echo "=== STAGE 6: SETUP R ENVIRONMENT ==="
    mkdir -p /home/r_libs && chmod -R 777 /home/r_libs
    echo "options(Ncpus = $(nproc))" >> /etc/R/Rprofile.site
    echo "Sys.setenv(MAKEFLAGS = '-j$(nproc)')" >> /etc/R/Rprofile.site
    echo "Sys.setenv(PKG_BUILD_EXTRA_FLAGS = '-j$(nproc)')" >> /etc/R/Rprofile.site
    
    echo "Available CPUs: $(nproc)"
    echo "Available memory before R package installation: $(free -h)"
    
    echo "=== STAGE 7: INSTALL CORE R PACKAGES ==="
    echo "Starting R package installation at: $(date)"
    Rscript /install_base_packages.R
    echo "R package installation completed at: $(date)"
    
    echo "Available memory after R package installation: $(free -h)"
    echo "Available disk space after R package installation: $(df -h /)"
    
    echo "=== BASE IMAGE BUILD COMPLETED SUCCESSFULLY ==="
    echo "Build finished at: $(date)"