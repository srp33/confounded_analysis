Bootstrap: docker
From: ubuntu:22.04

# Base image with system dependencies and core R packages
# Build this once and reuse for faster subsequent builds

%environment
export LANG="C.UTF-8"
export LC_ALL="C.UTF-8"
export TZ="America/Denver"
export R_LIBS_USER="/home/r_libs"

# Configure ccache for faster compilation
export PATH="/usr/lib/ccache:$PATH"
export CC="ccache gcc"
export CXX="ccache g++"
export CCACHE_DIR="/cache/ccache"
export CCACHE_MAXSIZE="8G"
export CCACHE_COMPRESS="true"
export CCACHE_COMPRESSLEVEL="6"

%files
    install_base_packages.R /install_base_packages.R

%post
    echo "Building base image with system dependencies and core R packages..."
    set -ex
    export DEBIAN_FRONTEND=noninteractive
    ln -fs /usr/share/zoneinfo/America/Denver /etc/localtime
    
    apt-get clean && apt-get update
    
    # Install system dependencies
    apt-get install -y --no-install-recommends \
        wget curl ca-certificates gnupg software-properties-common \
        git ccache build-essential cmake \
        python3 python3-pip python3-dev \
        libssl-dev libcurl4-openssl-dev libxml2-dev \
        libfontconfig1-dev libharfbuzz-dev libfribidi-dev \
        libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev \
        dirmngr apt-transport-https libx11-dev libmagick++-dev gsfonts pandoc libglpk-dev libwebp-dev
    
    # Add repositories
    wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc 2>/dev/null | gpg --dearmor - | tee /etc/apt/trusted.gpg.d/kitware.gpg >/dev/null
    add-apt-repository "deb https://apt.kitware.com/ubuntu/ $(lsb_release -cs) main"
    wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc | tee -a /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc
    add-apt-repository "deb https://cloud.r-project.org/bin/linux/ubuntu $(lsb_release -cs)-cran40/"
    
    apt-get update
    apt-get install -y --no-install-recommends r-base r-base-dev cmake
    apt-get clean && rm -rf /var/lib/apt/lists/*
    
    # Setup ccache
    mkdir -p /cache/ccache && chmod -R 777 /cache/ccache
    ccache --set-config=max_size=8G
    ccache --set-config=compression=true
    ccache --set-config=compression_level=6
    
    # Verify tools are working
    cmake --version
    R --version
    python3 --version
    ccache --show-config
    
    # Setup R
    mkdir -p /home/r_libs && chmod -R 777 /home/r_libs
    echo "options(Ncpus = $(nproc))" >> /etc/R/Rprofile.site
    echo "Sys.setenv(MAKEFLAGS = '-j$(nproc)')" >> /etc/R/Rprofile.site
    echo "Sys.setenv(PKG_BUILD_EXTRA_FLAGS = '-j$(nproc)')" >> /etc/R/Rprofile.site
    
    # Install core R packages (the time-consuming ones)
    Rscript /install_base_packages.R
    
    echo "Base image build completed."